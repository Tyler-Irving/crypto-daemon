# Crypto Trading Bot Configuration
# Copy this file to .env and fill in your actual values
# WARNING: Never commit .env to version control!

# === Telegram Notifications (Optional) ===
# Get bot token from @BotFather on Telegram
# Get chat ID by messaging @userinfobot
TG_BOT_TOKEN=your_telegram_bot_token_here
TG_CHAT_ID=your_telegram_chat_id

# Paper trading bot token (optional - for testing)
PAPER_TG_BOT_TOKEN=your_paper_trading_bot_token

# === Coinbase API Configuration ===
# Path to your coinbase.json credentials file
# Default: ~/.secrets/coinbase.json
# Format: {"api_key": "your_key", "api_secret": "your_secret"}
COINBASE_SECRETS_PATH=path/to/coinbase.json

# === File Paths (Optional - defaults to script directory) ===
# STATE_PATH=./monitor_state.json
# PORTFOLIO_PATH=./portfolio.json
# LOG_PATH=./trade_log.txt

# === Trading Parameters (Optional - defaults shown) ===
# Maximum USD amount per single position
# MAX_POSITION_USD=50.0

# Maximum number of concurrent open positions
# MAX_OPEN_POSITIONS=5

# Stop loss percentage (0.05 = 5%)
# STOP_LOSS_PCT=0.05

# Take profit percentage (0.08 = 8%)
# TAKE_PROFIT_PCT=0.08

# Minimum USD balance to keep in reserve
# MIN_USD_BALANCE=10.0

# Initial capital for portfolio tracking
# INITIAL_CAPITAL=100.0
